@startuml
!pragma layout smetana

top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam nodesep 40
skinparam ranksep 60
skinparam packageStyle rectangle
skinparam ArrowColor #61798A
skinparam ClassBorderColor #517D95
skinparam ClassBackgroundColor #EDF6FA
skinparam ClassFontColor #203B4E
skinparam PackageBorderColor #9BB3C2
hide empty methods
hide circle

package "1. Облікові записи та модерація" #F5F8FC {
  class "User\n(users)" as User {
    +id: BIGINT <<PK>>
    --
    full_name: VARCHAR
    email: VARCHAR
    password: VARCHAR
    role: ENUM
    --
    +isCustomer(): bool
    +isManager(): bool
    +isAdmin(): bool
    +bookings(): Collection
    +managedTours(): Collection
  }
  class "TourModerationRecord\n(tour_moderation_records)" as Moderation {
    +id: BIGINT <<PK>>
    --
    tour_id: BIGINT <<FK>>
    moderator_id: BIGINT <<FK>>
    decision: ENUM
    reason: TEXT
    created_at: DATETIME
    --
    +approve(): bool
    +reject(reason: string): bool
    +recordDecision(): void
    +getModerator(): User
    +getTour(): Tour
  }
}
package "2. Каталог та організація турів" #F4FAF8 {
  class "TourCategory\n(tour_categories)" as Category {
    +id: BIGINT <<PK>>
    --
    name: VARCHAR
    --
    +tours(): Collection
    +rename(name: string): void
    +validateName(): bool
    +getTourCount(): int
    +isEmpty(): bool
  }
  class "Destination\n(destinations)" as Destination {
    +id: BIGINT <<PK>>
    --
    country: VARCHAR
    region: VARCHAR
    city: VARCHAR
    --
    +tours(): Collection
    +hotels(): Collection
    +getFullName(): string
    +matchesCountry(country: string): bool
    +changeCity(city: string): void
  }
  class "Hotel\n(hotels)" as Hotel {
    +id: BIGINT <<PK>>
    --
    destination_id: BIGINT <<FK>>
    name: VARCHAR
    stars: INT
    address: VARCHAR
    --
    +destination(): Destination
    +tours(): Collection
    +getStars(): int
    +updateAddress(address: string): void
    +isLocatedIn(destinationId: int): bool
  }
  class "Tour\n(tours)" as Tour {
    +id: BIGINT <<PK>>
    --
    manager_id: BIGINT <<FK>>
    category_id: BIGINT <<FK>>
    destination_id: BIGINT <<FK>>
    title: VARCHAR
    description: TEXT
    base_price: DECIMAL
    status: ENUM
    --
    +manager(): User
    +category(): TourCategory
    +departures(): Collection
    +itineraryDays(): Collection
    +submitForModeration(): bool
  }
  class "TourHotel\n(tour_hotels)" as TourHotel {
    +tour_id: BIGINT <<PK, FK>>
    +hotel_id: BIGINT <<PK, FK>>
    --
    +tour(): Tour
    +hotel(): Hotel
    +getTourId(): int
    +getHotelId(): int
    +matches(tourId: int, hotelId: int): bool
  }
  class "ItineraryDay\n(itinerary_days)" as Itinerary {
    +id: BIGINT <<PK>>
    --
    tour_id: BIGINT <<FK>>
    day_number: INT
    title: VARCHAR
    activities: TEXT
    --
    +tour(): Tour
    +getDayNumber(): int
    +getActivities(): string
    +updateActivities(text: string): void
    +changeTitle(title: string): void
  }
  class "TourDeparture\n(tour_departures)" as Departure {
    +id: BIGINT <<PK>>
    --
    tour_id: BIGINT <<FK>>
    departure_date: DATE
    capacity: INT
    price: DECIMAL
    available_places: INT
    status: ENUM
    --
    +tour(): Tour
    +hasPlaces(count: int): bool
    +reserve(count: int): bool
    +release(count: int): void
    +isOpen(): bool
  }
}
package "3. Бронювання та оплати" #FFFAF3 {
  class "Booking\n(bookings)" as Booking {
    +id: BIGINT <<PK>>
    --
    user_id: BIGINT <<FK>>
    tour_departure_id: BIGINT <<FK>>
    booking_code: VARCHAR
    group_size: INT
    total_amount: DECIMAL
    status: ENUM
    --
    +customer(): User
    +departure(): TourDeparture
    +travelers(): Collection
    +payments(): Collection
    +cancel(): bool
  }
  class "Traveler\n(travelers)" as Traveler {
    +id: BIGINT <<PK>>
    --
    booking_id: BIGINT <<FK>>
    first_name: VARCHAR
    last_name: VARCHAR
    birth_date: DATE
    --
    +booking(): Booking
    +getFullName(): string
    +isAdult(): bool
    +changeName(first: string, last: string): void
    +getAge(): int
  }
  class "Payment\n(payments)" as Payment {
    +id: BIGINT <<PK>>
    --
    booking_id: BIGINT <<FK>>
    amount: DECIMAL
    method: ENUM
    status: ENUM
    paid_at: DATETIME
    --
    +booking(): Booking
    +markPaid(): bool
    +refund(amount: decimal): bool
    +isPaid(): bool
    +getAmount(): decimal
  }
}


' ==========================================
' 4. КОНТРОЛЕРИ MVC (тільки необхідні)
' ==========================================
package "4. Контролери MVC" #F4F4FC {
  abstract class "Controller" as Controller {
    #request: Request
    #response: Response
    #validator: Validator
    #auth: AuthManager
    #logger: Logger
    --
    #authorize(action: string): bool
    #validate(data: array): bool
    #render(view: string): View
    #redirect(url: string): RedirectResponse
    #log(message: string): void
  }

  class "TourController" as TourController {
    -tour: Tour
    -category: TourCategory
    -destination: Destination
    -departure: TourDeparture
    -itinerary: ItineraryDay
    --
    +index(filters: array): View
    +show(id: int): View
    +store(data: array): RedirectResponse
    +update(id: int, data: array): RedirectResponse
    +destroy(id: int): RedirectResponse
  }

  class "BookingController" as BookingController {
    -booking: Booking
    -traveler: Traveler
    -payment: Payment
    -departure: TourDeparture
    -customer: User
    --
    +index(): View
    +show(id: int): View
    +store(data: array): RedirectResponse
    +confirm(id: int): RedirectResponse
    +cancel(id: int): RedirectResponse
  }

  class "TourModerationController" as ModerationController {
    -record: TourModerationRecord
    -tour: Tour
    -moderator: User
    -category: TourCategory
    -destination: Destination
    --
    +index(): View
    +show(id: int): View
    +approve(tourId: int): RedirectResponse
    +reject(tourId: int, reason: string): RedirectResponse
    +history(tourId: int): View
  }
}

' Каркас компонування (невидимі лінії)
User -[hidden]right-> Moderation
Category -[hidden]right-> Destination
Destination -[hidden]right-> Hotel
Itinerary -[hidden]right-> TourHotel
TourHotel -[hidden]right-> Departure
Traveler -[hidden]right-> Payment

' Основні асоціації
User "1" -- "0..*" Tour : керує
Category "1" -- "0..*" Tour : категорія
Destination "1" -- "0..*" Tour : напрямок
Destination "1" -- "0..*" Hotel : розташування
User "1" -- "0..*" Booking : оформлює
Departure "1" -- "0..*" Booking : бронюється
Booking "1" -- "0..*" Payment : оплати
User "1" -- "0..*" Moderation : ухвалює рішення
Tour "1" -- "0..*" Moderation : історія модерації

' Композиції: об'єкти, які належать відповідному цілому
Tour "1" *-- "0..*" Departure : виїзди
Tour "1" *-- "0..*" Itinerary : дні програми
Booking "1" *-- "1..*" Traveler : учасники

' Агрегація M:N і її таблиця-зв'язка
Tour "0..*" o-- "0..*" Hotel : готелі туру
(Tour, Hotel) .. TourHotel


' Наслідування контролерів (UML generalization)
Controller <|-- TourController
Controller <|-- BookingController
Controller <|-- ModerationController

' Залежності контролерів від моделей (MVC)
TourController ..> Tour : використовує
BookingController ..> Booking : опрацьовує
ModerationController ..> Moderation : модерує

@enduml
